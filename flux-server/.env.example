# Hyperforge AI - image-generation only configuration
# Copy to .env and fill in the values you need.

# Hugging Face token. Required for gated models such as FLUX.1-dev and SD3.5.
HF_TOKEN=
SD3_HF_TOKEN=

# Optional API keys for browser/API clients. Comma-separated.
# Leave blank for local development only.
API_KEYS=

# Rate limiting, per API key or client IP.
RATE_LIMIT_PER_MINUTE=10

# CORS allowed origins. Use "*" for local development.
CORS_ORIGINS=*

# Model caches.
CACHE_DIR=/mnt/hf-cache
CACHE_DIR_SSD=/app/model_cache

# Generated image output directory.
OUTPUT_DIR=/mnt/outputs
OUTPUT_TTL_HOURS=24

# Persistent image LoRA adapter directory.
LORA_DIR=/mnt/hf-cache/loras
MAX_LORA_UPLOAD_MB=1536

# Request/body guardrail for LoRA uploads and JSON payloads.
MAX_REQUEST_BODY_MB=25

# Server settings.
HOST=0.0.0.0
PORT=8080
NUM_WORKERS=

# Image generation defaults.
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=28
DEFAULT_GUIDANCE_SCALE=3.5
MAX_WIDTH=2048
MAX_HEIGHT=2048

# FLUX quantization override: fp8, nf4, or bf16.
FLUX_QUANTIZE=fp8

# Offline mode after first cache fill.
HF_OFFLINE=false
